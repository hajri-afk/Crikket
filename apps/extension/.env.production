# Env untuk build production extension (`bun run --filter extension build` / `zip`).
# Vite/WXT memuat file ini HANYA di mode production, jadi `bun run dev`
# tetap memakai apps/extension/.env (localhost) untuk development.
#
# Nilai di-bake ke dalam bundle saat build — setiap perubahan wajib build ulang
# dan reload extension di chrome://extensions.

VITE_APP_URL=http://crikket.home
VITE_SERVER_URL=http://crikket.home
